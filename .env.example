# ---------------------------------------------------------------------------
# Invoice Studio — environment template
# Copy to server/.env (or project-root .env) and fill in real values.
# NEVER commit a filled-in .env — .gitignore already excludes it.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Database (MySQL 8 / MariaDB 10.4+) ------------------------------------
# WAMP/MariaDB often uses 3307; stock MySQL uses 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=invoice_app
DB_PASSWORD=replace-with-db-password
DB_NAME=invoice_studio
# Set to "true" only if your provider requires TLS (e.g. PlanetScale, Aiven).
DB_SSL=false

# --- Email (generic SMTP via nodemailer) -----------------------------------
# Works with any SMTP provider: Brevo, Mailgun, Postmark, Resend SMTP,
# Mailtrap, Gmail app passwords, your own mail server, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587/25).
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
# Quote the password if it contains '#', spaces or quotes. dotenv ends an
# unquoted value at the first '#', which silently truncates the password and
# shows up later as a confusing 535 "authentication failed".
SMTP_PASSWORD="replace-with-smtp-password"
# Envelope/From header. Must be an address your provider lets you send as.
MAIL_FROM_NAME=Northwind Studio Billing
MAIL_FROM_EMAIL=billing@example.com
# Optional: every outgoing invoice is also BCC'd here (useful for demos).
MAIL_BCC=
# Shared/cPanel hosts often present a certificate for the server's own hostname
# rather than the mail domain, which fails strict TLS verification. Set to
# "true" only if the handshake fails for that reason.
SMTP_ALLOW_SELF_SIGNED=false

# Dev convenience: when "true" and SMTP_HOST is unset, the server creates a
# throwaway Ethereal mailbox and returns a preview URL instead of delivering
# real mail. Leave "false" for production / real delivery.
MAIL_USE_ETHEREAL_FALLBACK=true
