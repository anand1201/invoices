{
  "name": "invoice-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Customizable invoice generator — React + Express + MySQL/MariaDB + SMTP email",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:init": "npm run db:init --workspace server",
    "test": "npm run test --workspace shared"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
